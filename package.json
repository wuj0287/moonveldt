{
  "name": "moonveldt",
  "productName": "Moonveldt",
  "version": "1.9.3",
  "description": "Moonveldt - an executable Markdown workspace: write, run, render, export, fully offline",
  "main": "main.js",
  "author": "Moonveldt",
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.1.1"
  },
  "build": {
    "appId": "com.moonveldt.editor",
    "productName": "Moonveldt",
    "electronVersion": "44.1.1",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "pyrun-core.js",
      "libs/**/*",
      "package.json"
    ],
    "win": {
      "icon": "moonveldt.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Moonveldt-Setup-${version}.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Moonveldt",
      "uninstallDisplayName": "Moonveldt - 可执行 Markdown 工作台"
    },
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown 文档 (Moonveldt)",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "Markdown 文档 (Moonveldt)",
        "role": "Editor"
      }
    ]
  }
}
